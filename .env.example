# Supabase Postgres connection string (Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Groq free-tier API (used for answer synthesis in production/demo)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama local (used for answer synthesis in dev when GROQ_API_KEY is unset)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
